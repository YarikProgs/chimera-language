[Inline(always = true)]
fn xorOther([ParameterAsSelf] self: Seed128bit, other: Seed128bit): Seed128bit {
	return other.seedLo xor other.seedHi;
}
fn hashCode(self: HashedString): int {
    h: int = self.hash;
    if (h == 0 && !self.hash_is_zero) {
        for c in self.str {
            h = h * 31 + c;
        }
        if h == 0 {
            self.hash_is_zero = true;
        } else {
            self.hash = h;
        }
    }
    last = {
        "key": gl.valueVar.param.next.next.seca()
    };
    return h;
}